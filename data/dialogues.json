      "display_name": "호숫가 사람",
      "region_id": "rain_lake",
      "dance_type": "side_step",
      "ending_order": 4,
      "dialogue_early": [
        "비가 계속 오네.",
        "물이 너무 흐려서 아무것도 안 보여."
      ],
      "dialogue_middle": [
        "가끔은 수면이 조용할 때도 있어.",
        "멀리서 뭔가 반짝이는 것 같기도 하고."
      ],
      "dialogue_late": [
        "오늘은 비가 좀 덜 오는 것 같은데.",
        "수면에 뭔가 비치는 게 있더라."
      ],
      "dialogue_final": [
        "빛이 들어오는 게 보이지?",
        "오랜만에 맑은 것 같아."
      ]
    },
    {
      "id": "garden_keeper",
      "display_name": "정원 관리인",
      "region_id": "memory_garden",
      "dance_type": "spin",
      "ending_order": 6,
      "dialogue_early": [
        "화단이 말라버렸어.",
        "예전엔 꽃이 많았는데."
      ],
      "dialogue_middle": [
        "물을 좀 줬더니 뭔가 나올 것 같기도 해.",
        "손을 대기가 망설여져."
      ],
      "dialogue_late": [
        "작은 게 하나 나왔어.",
        "뭐가 될지는 모르겠지만."
      ],
      "dialogue_final": [
        "봐. 꽃이 피었잖아.",
        "생각보다 빨리 피었어."
      ]
    },
    {
      "id": "theater_musician",
      "display_name": "극장의 연주자",
      "region_id": "old_theater",
      "dance_type": "late_join",
      "ending_order": 7,
      "dialogue_early": [
        "오래된 악기들만 남아 있어.",
        "언제 다시 연주할 수 있을지 모르겠어."
      ],
      "dialogue_middle": [
        "가끔 혼자 소리를 내봐.",
        "아무도 없는데도 연습이 되더라."
      ],
      "dialogue_late": [
        "조명이 켜지니까 달라 보여.",
        "여기서 뭔가 해볼 수 있을 것 같아."
      ],
      "dialogue_final": [
        "같이 연주해볼까?",
        "어떤 곡이든 괜찮아."
      ]
    }

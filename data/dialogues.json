      "ending_order": 3,
      "dialogue_early": [
        "오늘도 그냥 그런 날이지.",
        "숲이 왜 이렇게 어두운 건지 모르겠어."
      ],
      "dialogue_middle": [
        "오늘은 창문을 열어봤어.",
        "오래간만에 밖을 좀 봤지."
      ],
      "dialogue_late": [
        "생각보다 바람이 괜찮더라.",
        "어제는 조금 일찍 나왔어."
      ],
      "dialogue_final": [
        "내일은 어디 한번 가볼까.",
        "여기 오길 잘한 것 같아."
      ]

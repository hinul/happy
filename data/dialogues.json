      ],
      "dialogue_late": [
        "저번에 새 한 마리를 봤어.",
        "이름을 뭐라고 지을까."
      ],
      "dialogue_final": [
        "같이 뛰어볼래?",
        "저쪽에 더 가볼 거야?"

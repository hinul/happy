; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="오늘의 한 음"
config/version="1.0.0"
config/description="하나씩 찾다 보니, 어느새 음악이 되었다."
run/main_scene="res://scenes/main/TitleScreen.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://assets/ui/icon.png"
boot_splash/bg_color=Color(0.05, 0.05, 0.08, 1)
boot_splash/show_image=false

[autoload]

GameState="*res://scripts/autoload/GameState.gd"
SaveManager="*res://scripts/autoload/SaveManager.gd"
MusicManager="*res://scripts/autoload/MusicManager.gd"
WorldStateManager="*res://scripts/autoload/WorldStateManager.gd"
DialogueManager="*res://scripts/autoload/DialogueManager.gd"
InventoryManager="*res://scripts/autoload/InventoryManager.gd"
MapDiscoveryManager="*res://scripts/autoload/MapDiscoveryManager.gd"
SceneTransitionManager="*res://scripts/autoload/SceneTransitionManager.gd"
EndingDirector="*res://scripts/autoload/EndingDirector.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/resizable=true
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=0

[gui]

theme/custom_font="res://assets/fonts/NanumGothic.ttf"
theme/custom_font_size=12

